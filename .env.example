# Copy to .env and replace the external-service values marked change-me. Provider
# services must be real; CamCat deliberately has no mock/fallback provider.
CAMCAT_DATABASE_URL=postgresql+psycopg://camcat:camcat@postgres:5432/camcat
CAMCAT_OBJECT_STORE_ENDPOINT=http://minio:9000
# Bailian fetches video by signed URL, so this must be an Internet-reachable
# HTTPS reverse proxy or S3-compatible public endpoint for full video workflows.
# With local model services, use a browser-reachable address such as
# http://127.0.0.1:18963 instead.
CAMCAT_OBJECT_STORE_PUBLIC_ENDPOINT=https://change-me-public-media.example.com
# Optional infra/compose.media.yml: owned hostname only, without scheme or path.
# Must match the hostname above and have public DNS/ports 80 and 443 configured.
CAMCAT_MEDIA_DOMAIN=
CAMCAT_OBJECT_STORE_ACCESS_KEY=camcat
CAMCAT_OBJECT_STORE_SECRET_KEY=change-me-minio-secret
CAMCAT_OBJECT_STORE_BUCKET=camcat
CAMCAT_MILVUS_URI=http://milvus:19530
CAMCAT_MILVUS_TOKEN=
CAMCAT_MILVUS_COLLECTION=camcat_segments_v7

# local-single-user ignores browser X-User-Id and binds all data to LOCAL_USER_ID.
# multi-user requires identity headers from a trusted reverse proxy plus both secrets.
CAMCAT_SECURITY_MODE=local-single-user
CAMCAT_LOCAL_USER_ID=camcat-local-user
CAMCAT_TRUSTED_PROXY_SECRET=
CAMCAT_LIBRARY_ADMIN_KEY=

# CamCat's lightweight adapter calls Bailian's hosted models. No local GPU/model
# deployment is required. Use a workspace root such as https://<workspace>.maas.aliyuncs.com.
# The public object-store endpoint must be reachable by Bailian for video URL inputs.
# Optional in local-single-user mode. Set a strong private value in multi-user mode.
CAMCAT_PROVIDER_GATEWAY_API_KEY=
CAMCAT_BAILIAN_API_HOST=https://change-me.cn-beijing.maas.aliyuncs.com
CAMCAT_BAILIAN_API_KEY=change-me-rotated-bailian-key

# These default to the Compose provider-gateway. Override only for another adapter
# implementing docs/provider-contract.md.
CAMCAT_EMBEDDING_BASE_URL=http://provider-gateway:8010
# Leave these internal API keys empty to inherit CAMCAT_PROVIDER_GATEWAY_API_KEY.
CAMCAT_EMBEDDING_API_KEY=
CAMCAT_EMBEDDING_MODEL=Qwen/Qwen3-VL-Embedding-8B
CAMCAT_EMBEDDING_DIMENSION=2048
CAMCAT_EMBEDDING_VIDEO_FPS=1.0
CAMCAT_JOB_LEASE_SECONDS=600
# Standalone workers default to all. Compose runs separate analysis,
# localization and render roles, each with a unique worker ID.
CAMCAT_WORKER_ROLE=all

# Qwen3-VL-Reranker gateway contract: docs/provider-contract.md
CAMCAT_RERANKER_BASE_URL=http://provider-gateway:8010
CAMCAT_RERANKER_API_KEY=
CAMCAT_RERANKER_MODEL=Qwen/Qwen3-VL-Reranker-8B

# OpenAI-compatible Qwen chat endpoint plus CamCat's direct video description route.
CAMCAT_LLM_BASE_URL=http://provider-gateway:8010
CAMCAT_LLM_API_KEY=
CAMCAT_LLM_MODEL=qwen3-vl-plus
# Enable only on providers that implement JSON-schema constrained decoding.
CAMCAT_LLM_JSON_SCHEMA_ENABLED=false
CAMCAT_LLM_HEALTH_PATH=/health
CAMCAT_LLM_MAX_OUTPUT_TOKENS=0
CAMCAT_GATEWAY_RECEIPTS_DIR=
# Full-original choices cite their own source facts; saved reasons quote those facts.
CAMCAT_SOURCE_EVIDENCE_ENABLED=true
# Optional direct-video gateway when the planning endpoint uses another local model.
# Empty values inherit the LLM endpoint, key and model.
CAMCAT_VISUAL_ANALYSIS_BASE_URL=
CAMCAT_VISUAL_ANALYSIS_API_KEY=
CAMCAT_VISUAL_ANALYSIS_MODEL=
# Optional native multimodal helper for chronological ordering of complete originals.
# Configure all three together; scripts/configure_local_deployment.py --narrative-model
# selects the pinned local Qwen3.6-27B profile. General editing keeps CAMCAT_LLM_MODEL.
CAMCAT_NARRATIVE_BASE_URL=
CAMCAT_NARRATIVE_API_KEY=
CAMCAT_NARRATIVE_MODEL=

# OpenAI-compatible transcription endpoint.
CAMCAT_ASR_BASE_URL=http://provider-gateway:8010
CAMCAT_ASR_API_KEY=
CAMCAT_ASR_MODEL=qwen3-asr-flash
# Local configure-local selects pinned faster-whisper-large-v3-turbo on the local gateway.

# CamCat Studio adds translation/dubbing to the existing editing workflow.
# Empty translation values inherit CamCat's configured LLM provider.
CAMCAT_TRANSLATION_BASE_URL=
CAMCAT_TRANSLATION_API_KEY=
CAMCAT_TRANSLATION_MODEL=
# chat: structured chat provider; hymt: pinned local Hy-MT specialist with plain translation prompts.
# hymt requires an explicit translation URL, private key and model alias above.
CAMCAT_TRANSLATION_BACKEND=chat
# Maximum source video size allowed in one delivery ZIP (512 MiB).
CAMCAT_DELIVERY_MAX_BYTES=536870912
# `bash scripts/studio.sh prepare-speech` prepares the independent local CPU voice.
# Copy the private key from /data/zjr/camcat_studio/config/speech.env to your .env;
# do not publish that file. Enable Compose's local-speech profile when using Piper.
CAMCAT_TTS_BASE_URL=http://speech:18961
CAMCAT_TTS_API_KEY=
CAMCAT_TTS_MODEL=piper
CAMCAT_TTS_VOICE=en_US-lessac-medium
CAMCAT_TTS_REVISION=b145f2ac26522d6a2ccde0164b7b0e48b1e3199c
# Media/models/containers/logs stay under this path; source stays in Tracker.
CAMCAT_STUDIO_DATA=/data/zjr/camcat_studio
CAMCAT_API_PORT=18960
CAMCAT_WEB_PORT=18962
CAMCAT_S3_PORT=18963
CAMCAT_PG_PORT=18970
# Local host integration checks share the same absolute media paths as Compose.
# configure-local sets this to the project's physical runtime directory.
CAMCAT_SHARED_RUNTIME=
# Optional proxy for licensed external media downloads inside the application containers.
# configure-local fills these from the private project network configuration.
CAMCAT_CONTAINER_HTTP_PROXY=
CAMCAT_CONTAINER_HTTPS_PROXY=
CAMCAT_CONTAINER_NO_PROXY=localhost,127.0.0.1,10.0.2.2,api,postgres,minio,milvus,speech

# Optional Pixabay search importer. Without it, the seed script uses the real
# short sample explicitly published in Pixabay's API documentation.
PIXABAY_API_KEY=

# Frontend build/runtime values. Keep API base empty in Compose so the browser
# uses the Nginx same-origin /api proxy. Set http://127.0.0.1:8000 only for
# `npm run dev` outside Compose.
VITE_CAMCAT_API_BASE=
VITE_CAMCAT_USER_ID=camcat-local-user

# Host model daemon profiles are set in /data/zjr/camcat_studio/config/local-models.env.
# Two GPUs: export CAMCAT_LOCAL_GPU_INDICES=4,5 and CAMCAT_LOCAL_VISUAL_PRECISION=nf4.
# Three GPUs: export CAMCAT_LOCAL_GPU_INDICES=4,5,2 and CAMCAT_LOCAL_VISUAL_PRECISION=bfloat16.
# The canonical embedding remains BF16/2048 dimensions in both profiles.
